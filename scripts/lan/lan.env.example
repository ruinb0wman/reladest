# Readest LAN 档配置（**复制到 ~/readest-lan/webdav.env 后改密码**）
# 这个模板本身不含密钥，可以进仓库；真实的那份在仓库外，600 权限。
#
# 端口用 1732x 段：避开 3000/3001/5173/8080 这些常见占用（plan §0.2）

# WebDAV hub 凭据 —— Readest 设置里的 WebDAV 用户名/密码
WEBDAV_USER=readest
WEBDAV_PASS=CHANGE-ME

# hub 落盘目录（= Readest 远端 rootPath 的真实位置）
SYNC_ROOT=/home/ruinb0w/readest-sync

# 端口
HUB_PORT=17322
APP_PORT=17321
