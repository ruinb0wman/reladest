{
  "name": "@readest/monorepo",
  "private": true,
  "repository": "readest/readest",
  "scripts": {
    "dev": "bash scripts/lan/dev.sh",
    "dev:check": "bash scripts/lan/dev-check.sh",
    "dev:logs": "bash scripts/lan/dev-logs.sh",
    "stop": "bash scripts/lan/stop.sh",
    "build:android:x86": "bash scripts/lan/apk.sh x86_64",
    "build:android:arm64": "bash scripts/lan/apk.sh aarch64",
    "test": "pnpm test:types && pnpm test:lint && pnpm test:format && pnpm test:rust && pnpm test:unit",
    "test:unit": "pnpm --filter @readest/readest-app test",
    "test:browser": "pnpm --filter @readest/readest-app test:browser",
    "test:coverage": "pnpm --filter @readest/readest-app test:coverage",
    "test:rust": "pnpm --filter @readest/readest-app test:rust",
    "test:types": "pnpm --filter @readest/readest-app test:types",
    "test:lint": "pnpm --filter @readest/readest-app test:lint",
    "test:clippy": "pnpm --filter @readest/readest-app test:clippy",
    "test:format": "pnpm --filter @readest/readest-app test:format",
    "format": "pnpm --filter @readest/readest-app format",
    "setup:vendors": "pnpm --filter @readest/readest-app setup:vendors",
    "i18n:extract": "pnpm --filter @readest/readest-app i18n:extract",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@sindresorhus/tsconfig": "^6.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
