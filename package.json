{
  "name": "@readest/monorepo",
  "private": true,
  "repository": "readest/readest",
  "scripts": {
    "dev": "pnpm --filter @readest/readest-app dev",
    "build": "bash scripts/lan/build.sh",
    "start": "bash scripts/lan/start.sh",
    "stop": "bash scripts/lan/stop.sh",
    "status": "bash scripts/lan/status.sh",
    "watch": "bash scripts/lan/watch.sh",
    "logs": "tail -n 50 -f $HOME/readest-lan/logs/app.log $HOME/readest-lan/logs/webdav.log",
    "rebuild": "bash scripts/lan/rebuild.sh",
    "apk:x86": "bash scripts/lan/apk.sh x86_64",
    "apk:arm64": "bash scripts/lan/apk.sh aarch64",
    "test": "pnpm --filter @readest/readest-app test",
    "lint": "pnpm --filter @readest/readest-app lint",
    "test:rust": "pnpm --filter @readest/readest-app test:rust",
    "clippy": "pnpm --filter @readest/readest-app clippy:check",
    "fmt:check": "pnpm --filter @readest/readest-app fmt:check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@sindresorhus/tsconfig": "^6.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
